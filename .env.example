# =====================================================================
# TeleFlow - Environment Configuration (.env)
# =====================================================================

# 1. Telegram API Credentials (Mandatory)
# Obtain these by logging into https://my.telegram.org -> 'API development tools'
TG_API_ID=12345678
TG_API_HASH=your_api_hash_here

# 2. JWT Secret for Authentication & WebSockets (Mandatory)
# Generate a cryptographically secure random string with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_your_generated_random_secret_string_here

# 3. Server Binding Options (Optional, defaults: host 0.0.0.0, port 8000)
WEB_HOST=0.0.0.0
WEB_PORT=8000

# 4. Maximum Downloadable File Size in Megabytes (Optional, default: 4000MB / 4GB)
MAX_FILE_SIZE_MB=4000

# 5. [SECURITY] Allowed Output Directories for Absolute Paths
# Leave empty to STRICTLY DENY absolute paths outside the workspace (Recommended for Public / SaaS deployments).
# For private home servers, you can comma-separate allowed drives/folders.
# Example: ALLOWED_OUTPUT_DIRS="D:\Downloads, E:\Media"
ALLOWED_OUTPUT_DIRS=""

# 6. [SECURITY] Allow Shared Output (Cross-Tenant Data Mixing)
# If false (default), absolute paths automatically isolate downloads by user phone number.
# Set to "true" ONLY for single-user private servers.
ALLOW_SHARED_OUTPUT="false"